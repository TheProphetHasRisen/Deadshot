src/icon-192.png
src/icon-512.png
src/icon-maskable-512.png
src/vercel.json
# what the build leaves beside the sources; the published copies live at the site root
src/index.html
src/404.html
src/sw.js
src/og.png
src/og-*.png
src/t/
